{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/brand/**",
              "components/core/**",
              "components/feedback/**",
              "components/forms/**",
              "components/navigation/**",
              "components/nuggets/**",
              "prototype/**",
              "ui_kits/marketing_site/**",
              "ui_kits/mobile_app/**",
              "ui_kits/web_app/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Baloo 2|Figtree|DM Mono))/i]",
        "message": "Font not provided by the design system. Available: Baloo 2, Figtree, DM Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|children|style|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: tone, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:neutral|golden|ketchup|herb|ink)$/]",
        "message": "<Badge> tone must be one of 'neutral' | 'golden' | 'ketchup' | 'herb' | 'ink'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|fullWidth|disabled|iconLeft|iconRight|onClick|type|children|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, fullWidth, disabled, iconLeft, iconRight, onClick, type, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|ghost|danger)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'ghost' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:button|submit|reset)$/]",
        "message": "<Button> type must be one of 'button' | 'submit' | 'reset'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|padding|interactive|onClick|children|style|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: tone, padding, interactive, onClick, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:plain|cream|sunken|ink)$/]",
        "message": "<Card> tone must be one of 'plain' | 'cream' | 'sunken' | 'ink'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Dialog'] > JSXAttribute > JSXIdentifier[name!=/^(?:open|title|description|onClose|footer|width|children|key|ref|className|style|children)$/]",
        "message": "<Dialog> doesn't accept that prop. Declared props: open, title, description, onClose, footer, width, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='EmptyState'] > JSXAttribute > JSXIdentifier[name!=/^(?:headline|body|action|variant|style|key|ref|className|style|children)$/]",
        "message": "<EmptyState> doesn't accept that prop. Declared props: headline, body, action, variant, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='EmptyState'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:single|trio|bucket|dip)$/]",
        "message": "<EmptyState> variant must be one of 'single' | 'trio' | 'bucket' | 'dip'."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|variant|label|disabled|onClick|children|style|key|ref|className|style|children)$/]",
        "message": "<IconButton> doesn't accept that prop. Declared props: size, variant, label, disabled, onClick, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<IconButton> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:ghost|outline|filled)$/]",
        "message": "<IconButton> variant must be one of 'ghost' | 'outline' | 'filled'."
      },
      {
        "selector": "JSXOpeningElement[name.name='IdeaCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|notes|tags|date|archived|shape|bitten|biteBackground|seed|onClick|actions|style|key|ref|className|style|children)$/]",
        "message": "<IdeaCard> doesn't accept that prop. Declared props: title, notes, tags, date, archived, shape, bitten, biteBackground, seed, onClick, actions, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='IdeaCard'] > JSXAttribute[name.name='shape'] > Literal[value!=/^(?:fluid|soft)$/]",
        "message": "<IdeaCard> shape must be one of 'fluid' | 'soft'."
      },
      {
        "selector": "JSXOpeningElement[name.name='IdeaDraft'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|notes|tags|key|ref|className|style|children)$/]",
        "message": "<IdeaDraft> doesn't accept that prop. Declared props: title, notes, tags."
      },
      {
        "selector": "JSXOpeningElement[name.name='IdeaListItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|title|notes|tags|date|key|ref|className|style|children)$/]",
        "message": "<IdeaListItem> doesn't accept that prop. Declared props: id, title, notes, tags, date."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|placeholder|value|onChange|type|hint|error|disabled|iconLeft|id|style|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: label, placeholder, value, onChange, type, hint, error, disabled, iconLeft, id, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:text|email|password|search|url|number)$/]",
        "message": "<Input> type must be one of 'text' | 'email' | 'password' | 'search' | 'url' | 'number'."
      },
      {
        "selector": "JSXOpeningElement[name.name='NuggetMark'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|variant|bitten|style|key|ref|className|style|children)$/]",
        "message": "<NuggetMark> doesn't accept that prop. Declared props: size, variant, bitten, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='NuggetMark'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:single|alt|trio|bucket|dip)$/]",
        "message": "<NuggetMark> variant must be one of 'single' | 'alt' | 'trio' | 'bucket' | 'dip'."
      },
      {
        "selector": "JSXOpeningElement[name.name='RandomIdea'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|notes|tags|key|ref|className|style|children)$/]",
        "message": "<RandomIdea> doesn't accept that prop. Declared props: title, notes, tags."
      },
      {
        "selector": "JSXOpeningElement[name.name='SearchField'] > JSXAttribute > JSXIdentifier[name!=/^(?:placeholder|value|onChange|onClear|style|key|ref|className|style|children)$/]",
        "message": "<SearchField> doesn't accept that prop. Declared props: placeholder, value, onChange, onClear, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|dip|count|active|onClick|onRemove|children|style|key|ref|className|style|children)$/]",
        "message": "<Tag> doesn't accept that prop. Declared props: name, dip, count, active, onClick, onRemove, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute[name.name='dip'] > Literal[value!=/^(?:mustard|bbq|chilli|herb|curry|ranch)$/]",
        "message": "<Tag> dip must be one of 'mustard' | 'bbq' | 'chilli' | 'herb' | 'curry' | 'ranch'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TagCombobox'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|options|onChange|label|placeholder|style|key|ref|className|style|children)$/]",
        "message": "<TagCombobox> doesn't accept that prop. Declared props: value, options, onChange, label, placeholder, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TagFilterItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|count|key|ref|className|style|children)$/]",
        "message": "<TagFilterItem> doesn't accept that prop. Declared props: name, count."
      },
      {
        "selector": "JSXOpeningElement[name.name='Textarea'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|placeholder|value|onChange|rows|hint|disabled|id|style|key|ref|className|style|children)$/]",
        "message": "<Textarea> doesn't accept that prop. Declared props: label, placeholder, value, onChange, rows, hint, disabled, id, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TopBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:center|right|style|key|ref|className|style|children)$/]",
        "message": "<TopBar> doesn't accept that prop. Declared props: center, right, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ArchivedIdea'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|title|notes|tags|archivedAt|key|ref|className|style|children)$/]",
        "message": "<ArchivedIdea> doesn't accept that prop. Declared props: id, title, notes, tags, archivedAt."
      },
      {
        "selector": "JSXOpeningElement[name.name='Wordmark'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|tone|withMark|iconOnly|style|key|ref|className|style|children)$/]",
        "message": "<Wordmark> doesn't accept that prop. Declared props: size, tone, withMark, iconOnly, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Wordmark'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:ink|cream|golden)$/]",
        "message": "<Wordmark> tone must be one of 'ink' | 'cream' | 'golden'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
